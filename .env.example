# El chat usa Pollinations (GPT-OSS 20B) sin clave. El respaldo es Dots en Kilo.
# Para forzar otro enrutador compatible con OpenAI, completá estas dos:
# FREELLMAPI_BASE_URL=http://127.0.0.1:43124/v1
# FREELLMAPI_API_KEY=freellmapi-tu-clave
# FREELLMAPI_MODEL=openai-fast
# FREELLMAPI_LIGHT_MODEL=openai-fast
# FREELLMAPI_BACKUP_MODEL=dots-studio/dots-3-note-preview:free

# Opcional. Si FreeLLMAPI no está, Taskie llama directo a Gemini con esta clave.
GEMINI_API_KEY=

# Clave maestra del cofre (32 bytes en hex o base64). Si falta, se crea data/master.key.
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TASKIE_MASTER_KEY=

# Forzar cookies Secure aunque el proxy no mande x-forwarded-proto.
# TASKIE_SECURE_COOKIES=1

# Google Classroom: cliente OAuth de tipo Aplicación web (Google Cloud).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:43123/api/auth/google/callback
